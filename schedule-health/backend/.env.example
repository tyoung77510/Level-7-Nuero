# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
# Price IDs for the Starter, Pro, and Teams plans (see src/pricing.js for credit allotments).
# Create each product/price in the Stripe Dashboard, then paste its price_... ID here. Enterprise
# remains a "Contact us" placeholder in the UI with no checkout wired up — no price ID needed.
# One-time AI credit top-ups don't need a price ID either — they're created ad-hoc per purchase.
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAMS=price_...
# Optional, only needed once this app is deployed with a public URL and a webhook endpoint is
# registered in Stripe (Dashboard -> Developers -> Webhooks). Until then, subscription status and
# monthly credit refills are kept in sync via the post-checkout verification call instead (see
# backend/README.md).
STRIPE_WEBHOOK_SECRET=whsec_...

# Knock (Dashboard -> Developers -> API Keys, the secret key)
KNOCK_API_KEY=sk_test_or_sk_live_...
# Optional, for the "Suggest a feature" in-app feedback box: notifies your team by triggering a
# Knock workflow (you build the workflow itself in the Knock dashboard, e.g. one that emails/Slacks
# the team). Feedback is always saved to the database regardless of whether these are set.
KNOCK_FEEDBACK_WORKFLOW_KEY=ordo7-feedback
KNOCK_FEEDBACK_RECIPIENT_EMAIL=admin@level7data.com
# Optional, for email verification on signup: build a workflow in the Knock dashboard that sends
# an email with a "Verify your email" link/button using the {{data.verification_url}} variable
# (Knock passes it through automatically). IMPORTANT: verification is only *enforced* once this is set —
# without it, new signups skip verification entirely (same graceful-degradation pattern as the
# rest of this app). Existing accounts from before this was added are never retroactively locked
# out, even after this is turned on (see the migration note in src/db.js).
KNOCK_VERIFICATION_WORKFLOW_KEY=ordo7-verify-email
# Optional, for Teams seat invite emails: build a workflow using {{data.inviter_name}} and
# {{data.invite_url}}. Without this set, invites still work — the invite link is shown directly
# in the app for the owner to copy/share by hand (see the "Send invite" note in the Plan tab).
KNOCK_TEAM_INVITE_WORKFLOW_KEY=ordo7-team-invite
# Optional, for the "Forgot password?" flow: build a workflow using {{data.reset_url}}. Without
# this set, POST /api/auth/forgot-password returns a disclosed 503 rather than silently pretending
# to send an email nobody gets — same graceful-degradation pattern as the rest of this app.
KNOCK_PASSWORD_RESET_WORKFLOW_KEY=ordo7-password-reset
# Optional, for a live alert when a server-side error is logged: build a workflow using
# {{data.message}} and {{data.path}}. Errors are always recorded to the admin console's "Server
# Errors" panel regardless of whether this is set — this only adds a proactive notification on
# top, deduped to at most one alert per distinct error message per hour.
KNOCK_ERROR_ALERT_WORKFLOW_KEY=ordo7-error-alert
KNOCK_ERROR_ALERT_RECIPIENT_EMAIL=admin@level7data.com

# Anthropic (console.anthropic.com -> Settings -> API Keys) — powers the "Generate AI summary"
# button on the Report view. Uses Claude Haiku 4.5 by default. Without this set, the button is
# replaced with a message that the feature isn't configured yet; nothing else in the app is affected.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-haiku-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Social sign-in ("Continue with ..."). Each provider is entirely optional and independent — only
# providers with both ID and secret set show up as a button on the login screen (see
# src/oauth.js and the "Social sign-in" section of README.md). For each provider you enable, its
# redirect URI must be registered on that provider's app settings page as exactly:
#   https://yourdomain/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# X's OAuth 2.0 doesn't expose the user's email address, so X sign-in ends with a short "enter
# your email to finish" step rather than being fully one-click like the others.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Analytics/marketing trackers, gated behind the cookie-consent banner (src/consent.js on the
# client, GET /api/tracking-config on the server). Each is entirely optional and independent —
# unset trackers never load a script and their category is hidden from the consent banner
# entirely (never shown as an option that does nothing). The CSP is also extended only for the
# specific domain(s) of whichever tracker is actually configured, at server startup.
# GA4 (analytics.google.com -> Admin -> Data Streams -> your stream -> Measurement ID, "G-...").
GA4_MEASUREMENT_ID=
# Meta/Facebook Pixel (business.facebook.com -> Events Manager -> your pixel -> Settings).
META_PIXEL_ID=
# LinkedIn Insight Tag (campaignmanager.linkedin.com -> Account Assets -> Insight Tag -> Partner ID).
LINKEDIN_PARTNER_ID=

# MailerLite (Integrations -> API in the MailerLite dashboard) — powers the blog's "Subscribe"
# form (POST /api/blog/subscribe, see src/mailerlite.js). Subscribers are added to the "Ordo7
# Blog Subscribers" group. Without this set, the form returns a disclosed 503 rather than
# silently pretending to subscribe anyone — same graceful-degradation pattern as the rest of
# this app.
MAILERLITE_API_KEY=
